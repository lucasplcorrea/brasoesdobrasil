# Obrigatório antes de acessar APIs Wikimedia. Não invente um contato.
BRASOES_CONTACT=lucaspedrolopescorrea@gmail.com
BRASOES_REPOSITORY_URL=https://meta.wikimedia.org/wiki/User:BrasoesDoBrasilBot
BRASOES_HTTP_TIMEOUT_MS=15000
BRASOES_MAX_DOWNLOAD_BYTES=25000000
BRASOES_CONCURRENCY=1
BRASOES_REQUEST_DELAY_MS=30000
BRASOES_FAILURE_DELAY_MS=3600000

# Informe o nome completo gerado em Special:BotPasswords, incluindo @sufixo.
WIKIMEDIA_BOT_USERNAME=BrasoesDoBrasilBot@COLOQUE_O_SUFIXO
# Segredo: preencha somente no .env.worker, nunca versione.
WIKIMEDIA_BOT_PASSWORD=COLOQUE_A_SENHA_GERADA
